# Secretos para `npm run dev` (opcional). Copia este archivo como .dev.vars (git lo ignora).
# Sin ellos la tienda funciona en local, pero sin pagos ni emails.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
