# Cabeceras de los archivos estáticos en Cloudflare (Workers Static Assets).
# Las de seguridad deben coincidir con server/src/lib/security-headers.js.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com; font-src 'self'; connect-src 'self' https://*.googleapis.com https://www.gstatic.com https://api.cloudinary.com http://127.0.0.1:9099 http://localhost:9099 http://127.0.0.1:8080 http://localhost:8080; frame-src 'self' https://*.firebaseapp.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/css/*
  Cache-Control: public, max-age=600

/js/*
  Cache-Control: public, max-age=600

/assets/*
  Cache-Control: public, max-age=2592000

/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
