rules_version = '2';

// Fotos públicas de productos y tienda. Solo administradores pueden subir, reemplazar o borrar.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /store/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
